  "components": {
    "schemas": {
      "LoginDto": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "PaymentDto": {
        "required": [
          "amount",
          "paymentMethod",
          "transactionId"
        ],
        "type": "object",
        "properties": {
          "paymentMethod": {
            "minLength": 1,
            "pattern": "^(Card|EasyPaisa|JazzCash)$",
            "type": "string"
          },
          "transactionId": {
            "maxLength": 50,
            "minLength": 4,
            "type": "string"
          },
          "cardholderName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "cardNumber": {
            "type": "string",
            "format": "credit-card",
            "nullable": true
          },
          "expiryDate": {
            "pattern": "^(0[1-9]|1[0-2])\\/([0-9]{2})$",
            "type": "string",
            "nullable": true
          },
          "cvv": {
            "pattern": "^[0-9]{3,4}$",
            "type": "string",
            "nullable": true
          },
          "accountNumber": {
            "pattern": "^(03[0-9]{9})$",
            "type": "string",
            "nullable": true
          },
          "isVerified": {
            "type": "boolean"
          },
          "amount": {
            "minimum": 1,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "SignupDto": {
        "required": [
          "country",
          "dateOfBirth",
          "email",
          "firstName",
          "lastName",
          "password",
          "phoneNumber"
        ],
        "type": "object",
        "properties": {
          "firstName": {
            "maxLength": 50,
            "minLength": 1,
            "pattern": "^[a-zA-Z\\s]+$",
            "type": "string"
          },
          "lastName": {
            "maxLength": 50,
            "minLength": 1,
            "pattern": "^[a-zA-Z\\s]+$",
            "type": "string"
          },
          "email": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "maxLength": 100,
            "minLength": 8,
            "pattern": "^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[@$!%*?&])[A-Za-z\\d@$!%*?&]{8,}$",
            "type": "string"
          },
          "phoneNumber": {
            "maxLength": 20,
            "minLength": 1,
            "pattern": "^\\+?[0-9\\s\\-]+$",
            "type": "string"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date"
          },
          "country": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "SubmitStepDto": {
        "required": [
          "organization",
          "shift",
          "title"
        ],
        "type": "object",
        "properties": {
          "organization": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string"
          },
          "shift": {
            "minLength": 1,
            "pattern": "^(Morning|Evening)$",
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "nullable": true
          },
          "lastName": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}